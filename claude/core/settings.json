{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:20128/v1",
    "ANTHROPIC_AUTH_TOKEN": "sk_9router",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "cc/claude-fable-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cc/claude-opus-4-8",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cc/claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cx/gpt-5.4-mini"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/user-prompt-submit-notification.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-notification.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "theme": "dark",
  "hasCompletedOnboarding": true
}
