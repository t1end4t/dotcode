{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk_9router"
      },
      "models": {
        "ocg/glm-5.2": {
          "name": "ocg/glm-5.2",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "ocg/deepseek-v4-flash": {
          "name": "ocg/deepseek-v4-flash",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "cx/gpt-5.6-terra": {
          "name": "cx/gpt-5.6-terra",
          "options": {
            "reasoningEffort": "high"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "cx/gpt-5.6-sol": {
          "name": "cx/gpt-5.6-sol",
          "options": {
            "reasoningEffort": "high"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "lsp": true,
  "formatter": true,
  "model": "9router/cx/gpt-5.6-terra",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/ocg/deepseek-v4-flash"
    }
  }
}
