        },
        "cx/gpt-5.6-terra(medium)": {
          "name": "cx/gpt-5.6-terra",
          "options": {
            "reasoningEffort": "medium"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
