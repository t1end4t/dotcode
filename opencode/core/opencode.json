            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "lsp": true,
  "formatter": true,
  "model": "9router/paid-combo",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/paid-combo"
    }
  }
}
