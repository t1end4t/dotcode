{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk_9router"
      },
      "models": {
        "cc/claude-opus-5(high)": {
          "name": "cc/claude-opus-5",
