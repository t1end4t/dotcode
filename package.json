{
  "name": "dotcode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build frontend",
    "start": "NODE_ENV=production tsx backend/server.ts",
    "lint": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.*",
    "test:watch": "node --import tsx --test --watch tests/*.test.*"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
