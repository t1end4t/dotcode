{
  "name": "typescript-fullstack-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "npm run build -w frontend",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "node --import tsx --test tests/*.test.*",
    "test:watch": "node --import tsx --test --watch tests/*.test.*"
  },
  "workspaces": [
    "frontend"
  ],
  "dependencies": {
    "@openai/codex-sdk": "^0.163.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
